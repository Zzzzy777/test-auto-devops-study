# RuoYi frontend and backend addresses
RUOYI_FRONTEND_BASE_URL=http://localhost:82
RUOYI_API_BASE_URL=http://localhost:8081

# Test accounts: replace these values in local/Jenkins environments
RUOYI_UI_USERNAME=admin
RUOYI_UI_PASSWORD=admin123
RUOYI_API_USERNAME=admin
RUOYI_API_PASSWORD=admin123

# Timeouts in seconds/milliseconds as used by the project
RUOYI_UI_TIMEOUT=15000
RUOYI_API_TIMEOUT=10