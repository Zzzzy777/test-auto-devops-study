pipeline {
    // Windows Jenkins Agent is recommended because this pipeline uses powershell.
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'RUN_API', defaultValue: true, description: 'Run Pytest API tests')
        booleanParam(name: 'RUN_UI', defaultValue: true, description: 'Run Playwright UI tests')
        booleanParam(name: 'RUN_PERFORMANCE', defaultValue: false, description: 'Run JMeter performance test')
        string(name: 'PYTHON_CMD', defaultValue: 'python', description: 'Python command or absolute path on the Windows Agent')
        string(name: 'JMETER_CMD', defaultValue: 'jmeter', description: 'JMeter command or absolute path to jmeter.bat')
        string(name: 'PERF_THREADS', defaultValue: '5', description: 'JMeter concurrent threads')
        string(name: 'PERF_RAMP_UP', defaultValue: '10', description: 'JMeter ramp-up time in seconds')
        string(name: 'PERF_LOOPS', defaultValue: '2', description: 'JMeter loops per thread')
        string(name: 'PERF_MAX_ERROR_RATE', defaultValue: '0', description: 'Maximum allowed error rate in percent')
        string(name: 'PERF_MAX_P95_MS', defaultValue: '2000', description: 'Maximum allowed P95 response time in milliseconds')
    }

    environment {
        // Change these URLs when Jenkins Agent and RuoYi are not on the same machine.
        RUOYI_API_BASE_URL = 'http://localhost:8081'
        RUOYI_FRONTEND_BASE_URL = 'http://localhost:82'

        // Local demo defaults. Before using a public Jenkins/GitHub project, replace
        // these values with Jenkins Credentials and do not commit real passwords.
        RUOYI_API_USERNAME = 'admin'
        RUOYI_API_PASSWORD = 'admin123'
        RUOYI_UI_USERNAME = 'admin'
        RUOYI_UI_PASSWORD = 'admin123'
        RUOYI_DEFAULT_DEPT_ID = '105'
        PYTHONUNBUFFERED = '1'

        PYTHON_CMD = "${params.PYTHON_CMD}"
        JMETER_CMD = "${params.JMETER_CMD}"
        PERF_THREADS = "${params.PERF_THREADS}"
        PERF_RAMP_UP = "${params.PERF_RAMP_UP}"
        PERF_LOOPS = "${params.PERF_LOOPS}"
        PERF_MAX_ERROR_RATE = "${params.PERF_MAX_ERROR_RATE}"
        PERF_MAX_P95_MS = "${params.PERF_MAX_P95_MS}"
    }

    stages {
        stage('Prepare reports') {
            steps {
                dir('Ruoyi-api-ui-auto-test') {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        Write-Host "Project directory: $(Get-Location)"
                        New-Item -ItemType Directory -Force -Path `
                            'reports', 'reports/allure-results', 'reports/screenshots/fail', 'reports/jmeter' | Out-Null
                        Remove-Item -LiteralPath `
                            'reports/api-junit.xml', 'reports/ui-junit.xml', `
                            'reports/jmeter/result.jtl' `
                            -Force -ErrorAction SilentlyContinue
                        Remove-Item -Path 'reports/allure-results/*' -Recurse -Force -ErrorAction SilentlyContinue
                        Remove-Item -LiteralPath 'reports/jmeter/html' -Recurse -Force -ErrorAction SilentlyContinue
                        @(
                            "api.base.url=$env:RUOYI_API_BASE_URL"
                            "frontend.base.url=$env:RUOYI_FRONTEND_BASE_URL"
                            "jenkins.build=$env:BUILD_NUMBER"
                            "python.command=$env:PYTHON_CMD"
                            "performance.threads=$env:PERF_THREADS"
                            "performance.ramp_up=$env:PERF_RAMP_UP"
                            "performance.loops=$env:PERF_LOOPS"
                        ) | Set-Content -Encoding utf8 -Path 'reports/allure-results/environment.properties'
                        Write-Host "API: $env:RUOYI_API_BASE_URL"
                        Write-Host "Frontend: $env:RUOYI_FRONTEND_BASE_URL"
                    '''
                }
            }
        }

        stage('Check RuoYi services') {
            steps {
                dir('Ruoyi-api-ui-auto-test') {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        $apiUri = [System.Uri]$env:RUOYI_API_BASE_URL
                        $frontUri = [System.Uri]$env:RUOYI_FRONTEND_BASE_URL
                        $apiAvailable = Test-NetConnection -ComputerName $apiUri.Host -Port $apiUri.Port `
                            -InformationLevel Quiet -WarningAction SilentlyContinue
                        if (-not $apiAvailable) { throw "RuoYi API is unavailable: $env:RUOYI_API_BASE_URL" }
                        $frontAvailable = Test-NetConnection -ComputerName $frontUri.Host -Port $frontUri.Port `
                            -InformationLevel Quiet -WarningAction SilentlyContinue
                        if (-not $frontAvailable) { throw "RuoYi frontend is unavailable: $env:RUOYI_FRONTEND_BASE_URL" }
                        Write-Host 'RuoYi API and frontend checks passed.'
                    '''
                }
            }
        }

        stage('Install Python and Playwright dependencies') {
            steps {
                dir('Ruoyi-api-ui-auto-test') {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        & $env:PYTHON_CMD -m pip install -r requirements.txt
                        if ($LASTEXITCODE -ne 0) { throw 'Python dependency installation failed' }
                        & $env:PYTHON_CMD -m playwright install chromium
                        if ($LASTEXITCODE -ne 0) { throw 'Playwright Chromium installation failed' }
                    '''
                }
            }
        }

        stage('API tests') {
            when {
                expression { return params.RUN_API }
            }
            steps {
                dir('Ruoyi-api-ui-auto-test') {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        & $env:PYTHON_CMD -m pytest test_api -v --tb=short `
                            --alluredir=reports/allure-results `
                            --junitxml=reports/api-junit.xml
                        if ($LASTEXITCODE -ne 0) { throw 'API tests failed' }
                    '''
                }
            }
        }

        stage('UI tests') {
            when {
                expression { return params.RUN_UI }
            }
            steps {
                dir('Ruoyi-api-ui-auto-test') {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        & $env:PYTHON_CMD -m pytest test_ui -v --browser chromium --tb=short `
                            --alluredir=reports/allure-results `
                            --junitxml=reports/ui-junit.xml
                        if ($LASTEXITCODE -ne 0) { throw 'UI tests failed' }
                    '''
                }
            }
        }

        stage('JMeter performance test') {
            when {
                expression { return params.RUN_PERFORMANCE }
            }
            steps {
                dir('Ruoyi-api-ui-auto-test') {
                    powershell '''
                        $ErrorActionPreference = 'Stop'
                        $threads = [int]$env:PERF_THREADS
                        $rampUp = [int]$env:PERF_RAMP_UP
                        $loops = [int]$env:PERF_LOOPS
                        if ($threads -lt 1) { throw 'PERF_THREADS must be >= 1' }
                        if ($rampUp -lt 0) { throw 'PERF_RAMP_UP must be >= 0' }
                        if ($loops -lt 1) { throw 'PERF_LOOPS must be >= 1' }

                        $jmeterDir = 'reports/jmeter'
                        $htmlDir = Join-Path $jmeterDir 'html'
                        New-Item -ItemType Directory -Force -Path $jmeterDir | Out-Null
                        Remove-Item -LiteralPath "$jmeterDir/result.jtl" -Force -ErrorAction SilentlyContinue
                        Remove-Item -LiteralPath $htmlDir -Recurse -Force -ErrorAction SilentlyContinue

                        $apiUri = [System.Uri]$env:RUOYI_API_BASE_URL
                        Write-Host "JMeter parameters: threads=$threads, ramp_up=$rampUp, loops=$loops"
                        & $env:JMETER_CMD -n -t 'performance/RuoYi_login_user_list.jmx' `
                            "-Jhost=$($apiUri.Host)" `
                            "-Jport=$($apiUri.Port)" `
                            "-Jusername=$env:RUOYI_API_USERNAME" `
                            "-Jpassword=$env:RUOYI_API_PASSWORD" `
                            "-Jthreads=$threads" `
                            "-Jramp_up=$rampUp" `
                            "-Jloops=$loops" `
                            -l "$jmeterDir/result.jtl" -e -o $htmlDir
                        if ($LASTEXITCODE -ne 0) { throw 'JMeter performance test failed' }

                        & $env:PYTHON_CMD performance/check_jtl.py `
                            --jtl "$jmeterDir/result.jtl" `
                            --max-error-rate "$env:PERF_MAX_ERROR_RATE" `
                            --max-p95-ms "$env:PERF_MAX_P95_MS"
                        if ($LASTEXITCODE -ne 0) { throw 'JMeter performance quality gate failed' }
                    '''
                }
            }
        }
    }

    post {
        always {
            junit(
                allowEmptyResults: true,
                testResults: 'Ruoyi-api-ui-auto-test/reports/*-junit.xml'
            )
            archiveArtifacts(
                allowEmptyArchive: true,
                artifacts: 'Ruoyi-api-ui-auto-test/reports/**/*',
                fingerprint: true
            )
            // Requires Allure Jenkins Plugin and configured Allure Commandline.
            allure([
                includeProperties: false,
                reportBuildPolicy: 'ALWAYS',
                jdk: '',
                results: [[path: 'Ruoyi-api-ui-auto-test/reports/allure-results']]
            ])
            // Requires HTML Publisher Plugin. The report is generated only when
            // RUN_PERFORMANCE=true, therefore allowMissing must remain true.
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'Ruoyi-api-ui-auto-test/reports/jmeter/html',
                reportFiles: 'index.html',
                reportName: 'JMeter Performance Report'
            ])
        }
    }
}